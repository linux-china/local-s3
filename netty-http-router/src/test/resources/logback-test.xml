<configuration>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <Pattern>%date{"yyyy-MM-dd HH:mm:ss.SSS"} %-5level [%thread] %logger{36}:%line - %msg%n%throwable</Pattern>
        </encoder>
    </appender>

    <root level="warn">
        <appender-ref ref="STDOUT" />
    </root>
</configuration>
